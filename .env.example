# Secret key for sessions and cryptographic signing
SECRET_KEY=mindvault-change-this-to-a-secure-random-key-in-production

# Database URI (SQLite for local development, Neon PostgreSQL for production)
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require&channel_binding=require
DATABASE_URL=sqlite:///mindvault.db

# Cloudinary Storage for Permanent Cloud Images & PDF Archival
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Flask Environment (development / production)
FLASK_ENV=development

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# External Community Discussion Platform
COMMUNITY_URL=https://ecellcup.onrender.com/community

# Rate Limiting Storage
RATELIMIT_STORAGE_URI=memory://
